    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Navega cirurgicamente na estrutura exata do nó LangChain/Gemini\nlet textoIA = \"\";\n\nif ($input.item.json?.content?.parts?.[0]?.text) {\n    // É AQUI QUE O JSON ESTÁ !\n    textoIA = $input.item.json.content.parts[0].text;\n} else if ($input.item.json?.text) {\n    // Fallback padrão n8n\n    textoIA = $input.item.json.text; \n} else if ($input.item.json?.message?.content) {\n    // Fallback OpenAI\n    textoIA = $input.item.json.message.content;\n} else {\n    textoIA = $input.item.json?.content || \"\";\n}\n\n// 2. Proteção contra retornos vazios\nif (!textoIA || textoIA === \"\") {\n    return { json: { categoria: \"FALHA_IA\", resumo: \"Texto não encontrado na estrutura.\", urgencia: 1 } };\n}\n\n// 3. Se a IA já converteu pra objeto de forma invisível\nif (typeof textoIA === 'object' && textoIA !== null) {\n    if (textoIA.categoria) return { json: textoIA };\n    textoIA = JSON.stringify(textoIA);\n}\n\n// 4. A Mágica Final: Limpa o Markdown e converte a String em Objeto Real\ntry {\n    let textoLimpo = String(textoIA).replace(/```json/gi, '').replace(/```/gi, '').trim();\n    let dados = JSON.parse(textoLimpo);\n    \n    // Garante que as chaves existam para o Supabase não chorar\n    if (!dados.categoria) dados.categoria = \"SEM_CATEGORIA\";\n    if (!dados.resumo) dados.resumo = \"Resumo ausente.\";\n    if (!dados.tags) dados.tags = [];\n    \n    return { json: dados };\n} catch (error) {\n    // Se a IA alucinar e não mandar JSON, não quebra o loop\n    let pedacoTexto = String(textoIA).substring(0, 100);\n    return { json: { categoria: \"ERRO_FORMATO\", resumo: \"Falha ao ler JSON: \" + pedacoTexto, urgencia: 1 } };\n}"
      },
